# Copy to .env and edit (docs/operations/docker.md). Any setting can be set
# as REPORTD_<PATH> (REPORTD_TEMPLATESTORE_DRIVER); add it to reportd's
# environment in docker-compose.yml.

# The image: Frontforge Report Server 0.10.0, which docker-compose.yml
# names. Set it only to run another.
#REPORTD_IMAGE=ghcr.io/frontforge-corporation/report-server:0.10.0
# The port on this machine.
REPORTD_PORT=43123
# Where people reach reportd. Unset, the setup wizard asks.
#REPORTD_PUBLICURL=https://reports.example.com
# json for a log collector; text by default.
#REPORTD_LOGGING_FORMAT=json
# false turns off the daily check for a newer release.
#REPORTD_UPDATES_CHECK=false
