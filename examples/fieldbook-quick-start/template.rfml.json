  "pages": [
    {
      "id": "card-page",
      "size": "A5",
      "margin": "9mm 12mm 14mm",
      "footerDistance": "6mm",
      "footer": [
        {
          "type": "text",
          "id": "page-footer",
          "class": [
            "small",
            "muted"
          ],
          "style": {
            "text-align": "center"
          },
          "content": "Quillmont Software · quillmont.example · support@quillmont.example · +61 2 5550 0123"
        }
      ],
      "background": [
        {
          "type": "box",
          "id": "edge",
          "style": {
            "height": "3mm",
            "background-color": "var(--brand)",
            "top": 0,
            "right": 0,
            "left": 0
          }
        }
      ]
    }
  ],
  "body": [
    {
      "type": "use",
      "id": "card-en",
      "if": "params.language != 'de-DE'",
      "component": "quick-start-card",
      "lang": "en-GB"
    },
    {
      "type": "use",
      "id": "card-de",
      "if": "params.language == 'de-DE'",
      "component": "quick-start-card",
      "lang": "de-DE"
    }
  ],
  "tests": [
    {
      "name": "sample in English fits one A5 page",
      "data": {
        "main": "samples/main.json"
      },
      "params": {
        "language": "en-GB"
      },
      "expect": [
        "pages.size() == 1",
        "diagnostics.all(d, d.severity != 'error' && d.severity != 'warning')",
        "visible('card-en') && !visible('card-de')",
        "text('card-en/title') == 'Get started in five steps'",
        "text('card-en/card-date') == 'Updated 2 November 2026'",
        "text('card-en/step-install-body').contains('(86.4 MB)')",
        "text('card-en/step-offline-body').contains('12,000 photos')",
        "text('card-en/price-value') == '€12.50 per user a month'",
        "text('card-en/users-value') == '18 users, 2 devices each'",
        "text('card-en/storage-value') == '37.6 of 250 GB used (15%)'",
        "text('card-en/renews-value') == '1 January 2027'",
        "nodes('card-en/days-cell').map(b, b.text) == ['Mon to Fri', 'Mon to Fri', 'Saturday', 'Every day']",
        "visible('card-en/help-code')"
      ],
      "snapshot": true
    },
    {
      "name": "sample in German fits one A5 page",
      "data": {
        "main": "samples/main.json"
      },
      "params": {
        "language": "de-DE"
      },
      "expect": [
        "pages.size() == 1",
        "diagnostics.all(d, d.severity != 'error' && d.severity != 'warning')",
        "visible('card-de') && !visible('card-en')",
        "text('card-de/title') == 'In fünf Schritten startklar'",
        "text('card-de/card-date') == 'Stand: 2. November 2026'",
        "text('card-de/step-install-body').contains('(86,4 MB)')",
        "text('card-de/step-offline-body').contains('12.000 Fotos')",
        "text('card-de/users-value') == '18 Personen, je 2 Geräte'",
        "text('card-de/renews-value') == '1. Januar 2027'",
        "nodes('card-de/hours-cell').map(b, b.text)[0] == '08:00–18:00 Uhr'"
      ],
      "snapshot": true
    },
    {
      "name": "one user on one device reads in the singular",
      "data": {
        "main": "tests/single-user.json"
      },
      "params": {
        "language": "de-DE"
      },
      "expect": [
        "pages.size() == 1",
        "text('card-de/users-value') == '1 Person, je 1 Gerät'",
        "!visible('card-de/admin-value')",
        "nodes('card-de/hours-cell').map(b, b.text) == ['Antwort in 1 Stunde']"
      ]
    }
  ]
}
